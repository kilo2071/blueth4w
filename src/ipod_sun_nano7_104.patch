+/// iPod nano 7G on stock firmware 1.0.4 (37A40005). Derived + validated against
+/// the decrypted 1.0.4 and 1.1.2 osos (see ghidra/EXPLOIT_CONSTANTS_104.md in the
+/// na-no research pack): cff_slot_load is byte-for-byte structurally identical to
+/// 1.1.2's, so every frame offset is unchanged and only the absolute addresses of
+/// cff_slot_load (-4), the CFF decoder (-4) and the overwritten SCSI handler (-4)
+/// shift; the nothrow allocator is unchanged.
+pub struct ExploitConfigN7_104;
+impl ExploitConfig for ExploitConfigN7_104 {
+    const OFFSET_BUILDCHAR_LEN_PTR: u16 = 120;
+    const OFFSET_BUILDCHAR_PTR: u16 = Self::OFFSET_BUILDCHAR_LEN_PTR - 1;
+    // 1.0.4 cff_slot_load is 0x0813a3f0 (1.1.2: 0x0813a3f4). Same frame: decoder at
+    // sp+0x2c, LR at sp+0x3a4, pivot decoder+0x11c, so OFFSET_LR is unchanged.
+    const OFFSET_LR: u16 = 151;
+    const OFFSET_CHARSTRING_PTR: u16 = 132;
+    const PUSH_COUNT: usize = 43;
+    const SWAP_COUNT: usize = 128;
+    const DROP_COUNT: usize = Self::SWAP_COUNT + 17;
+    const PATCH_MFG_STR: bool = false;
+    // 1.0.4 SCSI command handler overwritten with the RWX stub (1.1.2: 0x0819c458).
+    const BUILDCHAR_OVERWRITE_ADDR: u32 = 0x0819_c454_u32;
+    const BUILDCHAR_WRITE_OFFSET: u16 = 0;
+}
